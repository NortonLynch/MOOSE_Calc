@@ Run after prepare_gamma_prime.TCM. Only FCC_L12#2 is entered.
advanced_options global_minimization N N
@@ DGM is already defined in the restored equilibrium workspace.
enter_symbol function GRES=GM+47425.823+135156.45*X(AL);
enter_symbol function DMUREF=MU(AL)-MU(NI)+135156.45;
enter_symbol table GPRIME=X(AL),GM,MU(AL),MU(NI),VM;
enter_symbol table GPDERIV=X(AL),DGM,GRES,DMUREF;
enter_symbol table GPORDER=X(AL),NPM(FCC_L12#2),Y(FCC_L12#2,AL#1),Y(FCC_L12#2,AL#2);
save D:/MOOSEcalc/thermodynamics/raw/gamma_prime_scan_1000K
set_axis_variable 1 X(AL) 0.18 0.30 0.0005
step_with_options normal
tabulate GPRIME D:/MOOSEcalc/thermodynamics/raw/gamma_prime_bulk_1000K.txt
tabulate GPDERIV D:/MOOSEcalc/thermodynamics/raw/gamma_prime_reduced_1000K.txt
tabulate GPORDER D:/MOOSEcalc/thermodynamics/raw/gamma_prime_order_1000K.txt
set_interactive
