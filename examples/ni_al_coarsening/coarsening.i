# Ni-14 at.% Al, 1000 K. Demonstration with REFERENCE kinetics, not calibrated time.
# Generated by scripts/prepare_ni_al_coarsening.py.
# Coordinates: 1 unit = 1 nm. Time: t*; reference t0 = 1 s.
# Analytically eliminated KKS constraints for two local quadratic phase free energies.
[Mesh]
  [domain]
    type = GeneratedMeshGenerator
    dim = 2
    nx = 96
    ny = 96
    xmax = 96.0
    ymax = 96.0
  []
[]
[Variables]
  [eta]
    [InitialCondition]
      type = FunctionIC
      function = eta_initial
    []
  []
  [c]
    [InitialCondition]
      type = FunctionIC
      function = c_initial
    []
  []
  [mu]
    initial_condition = -0.05090600875248213
  []
[]
[Functions]
  [eta_initial]
    type = ParsedFunction
    expression = '1-(1-0.5*(1-tanh((sqrt((x-24.0)^2+(y-24.0)^2)-9.2)/1.820478453253675)))*(1-0.5*(1-tanh((sqrt((x-72.0)^2+(y-24.0)^2)-9.7)/1.820478453253675)))*(1-0.5*(1-tanh((sqrt((x-24.0)^2+(y-72.0)^2)-10.3)/1.820478453253675)))*(1-0.5*(1-tanh((sqrt((x-72.0)^2+(y-72.0)^2)-10.8)/1.820478453253675)))'
  []
  [c_initial]
    type = ParsedFunction
    expression = 'eta0:=1-(1-0.5*(1-tanh((sqrt((x-24.0)^2+(y-24.0)^2)-9.2)/1.820478453253675)))*(1-0.5*(1-tanh((sqrt((x-72.0)^2+(y-24.0)^2)-9.7)/1.820478453253675)))*(1-0.5*(1-tanh((sqrt((x-24.0)^2+(y-72.0)^2)-10.3)/1.820478453253675)))*(1-0.5*(1-tanh((sqrt((x-72.0)^2+(y-72.0)^2)-10.8)/1.820478453253675)));h:=eta0^3*(6*eta0^2-15*eta0+10);0.124644+h*0.112518+(-0.05090600875248213)*((1-h)/347.9729999999997+h/424.3473999999995)'
  []
[]
[BCs]
  [Periodic]
    [xy]
      auto_direction = 'x y'
    []
  []
[]
[Kernels]
  [chemical_potential]
    type = SplitCHParsed
    variable = c
    w = mu
    f_name = F
    kappa_name = kappa_c
    coupled_variables = eta
  []
  [conservation]
    type = CoupledTimeDerivative
    variable = mu
    v = c
  []
  [diffusion]
    type = SplitCHWRes
    variable = mu
    mob_name = M
  []
  [interface_time]
    type = TimeDerivative
    variable = eta
  []
  [interface_bulk]
    type = AllenCahn
    variable = eta
    f_name = F
    coupled_variables = c
    mob_name = L
  []
  [interface_gradient]
    type = ACInterface
    variable = eta
    kappa_name = kappa_eta
    mob_name = L
  []
[]
[Materials]
  [free_energy]
    type = DerivativeParsedMaterial
    property_name = F
    coupled_variables = 'c eta'
    expression = 'h:=eta^3*(6*eta^2-15*eta+10);q:=(1-h)/347.9729999999997+h/424.3473999999995;0.5*(c-0.124644-h*0.112518)^2/q+0.4614171612406061*eta^2*(1-eta)^2'
    derivative_order = 2
  []
  [constants]
    type = GenericConstantMaterial
    prop_names = 'M L kappa_c kappa_eta'
    prop_values = '0.002873786184560299 10 0 0.7646009503665432'
  []
[]
[AuxVariables]
  [gamma_prime_fraction]
  []
  [c_gamma]
  []
  [c_gamma_prime]
  []
  [diffusion_potential_J_mol]
  []
  [energy_density]
    family = MONOMIAL
    order = CONSTANT
  []
[]
[AuxKernels]
  [phase_fraction]
    type = ParsedAux
    variable = gamma_prime_fraction
    coupled_variables = eta
    expression = 'eta^3*(6*eta^2-15*eta+10)'
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [matrix_composition]
    type = ParsedAux
    variable = c_gamma
    coupled_variables = mu
    expression = '0.124644+mu/347.9729999999997'
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [precipitate_composition]
    type = ParsedAux
    variable = c_gamma_prime
    coupled_variables = mu
    expression = '0.237162+mu/424.3473999999995'
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [potential_units]
    type = ParsedAux
    variable = diffusion_potential_J_mol
    coupled_variables = mu
    expression = '1000.0*mu'
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [energy]
    type = TotalFreeEnergy
    variable = energy_density
    f_name = F
    interfacial_vars = eta
    kappa_names = kappa_eta
    execute_on = 'INITIAL TIMESTEP_END'
  []
[]
[Postprocessors]
  [mean_c]
    type = ElementAverageValue
    variable = c
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [mean_gamma_prime_fraction]
    type = ElementAverageValue
    variable = gamma_prime_fraction
    execute_on = 'INITIAL TIMESTEP_END'
  []
  [total_energy]
    type = ElementIntegralVariablePostprocessor
    variable = energy_density
    execute_on = 'INITIAL TIMESTEP_END'
  []
[]
[Preconditioning]
  [smp]
    type = SMP
    full = true
  []
[]
[Executioner]
  type = Transient
  solve_type = NEWTON
  scheme = implicit-euler
  petsc_options_iname = '-pc_type -pc_factor_mat_solver_type'
  petsc_options_value = 'lu mumps'
  nl_rel_tol = 1e-8
  nl_abs_tol = 1e-10
  nl_max_its = 30
  l_max_its = 30
  end_time = 60000
  num_steps = 20000
  dtmax = 400
  dtmin = 1e-5
  [TimeStepper]
    type = IterationAdaptiveDT
    dt = 0.2
    optimal_iterations = 20
    iteration_window = 3
    growth_factor = 1.5
    cutback_factor = 0.5
  []
[]
[Outputs]
  file_base = results/ni_al_coarsening/coarsening
  execute_on = 'INITIAL TIMESTEP_END'
  csv = true
  [fields]
    type = Exodus
    execute_on = 'INITIAL TIMESTEP_END FINAL'
    time_step_interval = 5
  []
  [restart]
    type = Checkpoint
    time_step_interval = 100
    num_files = 2
  []
[]
